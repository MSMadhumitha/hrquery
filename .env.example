# Gemini API Key (Required for live Gemini Embeddings and LLM Generation)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Generation and Embedding model configurations
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# Optional: RAG parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
RELEVANCE_THRESHOLD=0.38
